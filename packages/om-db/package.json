{
  "name": "@open-marketing/om-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "om": {
    "kind": "shared"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/src/testing.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "node ../../development/scripts/build.mjs",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@jini-ai/db": "0.6.12",
    "@open-marketing/contracts": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "kysely": "0.29.6",
    "vitest": "3.2.4"
  }
}
