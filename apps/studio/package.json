{
  "name": "@open-marketing/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "om": {
    "kind": "app",
    "composition": "src/composition/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "node ../../development/scripts/build.mjs",
    "test": "vitest run tests",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@jini-ai/agentic": "0.4.4",
    "@jini-ai/chat": "0.6.2",
    "@jini-ai/ui": "0.5.2",
    "@open-marketing/contracts": "workspace:*",
    "@open-marketing/om-clock": "workspace:*",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "7.2.2",
    "zod": "4.1.13"
  }
}
