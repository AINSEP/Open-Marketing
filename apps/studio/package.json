  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@jini-ai/agent-runtime": "0.6.12",
    "@jini-ai/agentic": "0.6.12",
    "@jini-ai/chat": "0.6.12",
    "@jini-ai/diagnostics": "0.6.12",
    "@jini-ai/platform": "0.6.12",
    "@jini-ai/ui": "0.6.12",
    "@mcp-ui/client": "7.1.1",
    "@open-marketing/contracts": "workspace:*",
    "@open-marketing/om-clock": "workspace:*",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "2.6.1",
    "vite": "7.2.2",
    "zod": "4.1.13"
  }
