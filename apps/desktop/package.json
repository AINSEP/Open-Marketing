{
  "name": "@open-marketing/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "om": {
    "kind": "app",
    "composition": "src/composition/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "node ../../development/scripts/build.mjs",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@jini-ai/desktop-host": "0.4.2",
    "@open-marketing/contracts": "workspace:*",
    "@open-marketing/om-clock": "workspace:*",
    "electron": "39.2.3",
    "zod": "4.1.13"
  }
}
