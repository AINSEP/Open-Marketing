    "@open-marketing/safety": "workspace:*",
    "@open-marketing/web-events": "workspace:*",
    "@open-marketing/workspaces": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.6",
    "yaml": "2.8.1",
