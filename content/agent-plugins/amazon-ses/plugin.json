{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "amazon-ses",
  "version": "0.1.0",
  "description": "SES account/domain reads and a Jini mail provider with signed SNS feedback; disabled until host integration.",
  "license": "Apache-2.0",
  "extensions": { "io.github.ainsep.openmarketing": {
      "credentialAssets": {"io.github.ainsep.openmarketing/assets/icon.svg": "968752e8b4f9f81e4c237a8692b22e567648f872494adc632e8ba92fe8e21488"},
    "version": 1, "enabled": false, "admitted": false,
    "mailAdapters": [{"id": "amazon_ses", "label": "Amazon SES", "module": "io.github.ainsep.openmarketing/dist/index.mjs", "credentialKeys": ["token"], "feedback": false}],
    "capabilities": [
      {"capabilityId": "email.account-read.v1", "version": 1, "pluginId": "amazon-ses", "schemaFingerprint": "521c94c2b0f58114f1ca2c13c7bd95ebd5d968164ca82b80e1ccfa5cf6220886", "admitted": false, "effects": ["read"]},
      {"capabilityId": "email.identity-read.v1", "version": 1, "pluginId": "amazon-ses", "schemaFingerprint": "521c94c2b0f58114f1ca2c13c7bd95ebd5d968164ca82b80e1ccfa5cf6220886", "admitted": false, "effects": ["read"]}
    ],
    "credentialCards": [
        {
          "target": "amazon-ses", "title": "Amazon SES", "label": "Save IAM credentials", "category": "Email",
          "intro": "Enter your IAM API access keys and AWS region. Use an IAM user with SES permissions, rather than root or SMTP credentials. Saving does not enable delivery.",
          "usedFor": ["Regional sending quota", "Domain verification and DKIM"],
          "helpUrl": "https://docs.aws.amazon.com/ses/latest/dg/control-user-access.html", "helpLabel": "SES API access and permissions",
          "baseUrl": "https://aws.amazon.com",
          "saveKind": "app-credentials", "saveTarget": "amazon-ses", "icon": "io.github.ainsep.openmarketing/assets/icon.svg",
          "fields": [{"name": "region", "label": "AWS region", "required": true, "type": "string"}],
          "secretFields": [{"name": "accessKeyId", "label": "IAM access key ID", "required": true}, {"name": "secretAccessKey", "label": "IAM secret access key", "required": true}],
          "permissions": ["ses:GetAccount", "ses:GetEmailIdentity", "ses:SendEmail"]
        }
      ]
  }}
}
