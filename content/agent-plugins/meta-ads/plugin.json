{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "meta-ads",
  "version": "0.1.0",
  "description": "Meta campaign codecs, server-only CAPI and organic Instagram publishing; disabled until host admission.",
  "license": "Apache-2.0",
  "extensions": {
    "io.github.ainsep.openmarketing": {
      "conversionSettings": {
        "fields": [{ "name": "datasetId", "label": "Dataset ID", "hint": "Numeric dataset ID for conversion events", "kind": "string", "format": "decimal-id" }]
      },
      "credentialCards": [
        {
          "target": "meta-ads",
          "title": "Meta Ads and Instagram",
          "label": "Connect Meta Ads",
          "category": "Advertising",
          "intro": "Use Meta Business Login with a user-token configuration. Check the exact redirect URI in the App Dashboard: Strict Mode/Enforce HTTPS may reject http://127.0.0.1.",
          "usedFor": [
            "Read and manage Meta advertising campaigns and performance",
            "Publish Instagram posts and read account insights",
            "Deliver consented conversions through server measurement jobs"
          ],
          "helpUrl": "https://developers.facebook.com/docs/facebook-login/facebook-login-for-business/",
          "helpLabel": "Authentication and setup",
          "baseUrl": "https://graph.facebook.com",
          "saveKind": "oauth",
          "saveTarget": "meta-ads",
          "icon": "io.github.ainsep.openmarketing/assets/icon.svg",
          "permissions": [
            "Advertising reads and management (ads_read, ads_management)",
            "Business assets (business_management)",
            "Page discovery (pages_show_list, pages_read_engagement)",
            "Instagram accounts and publishing (instagram_basic, instagram_content_publish)",
            "Instagram insights (instagram_manage_insights)"
          ]
        },
        {
          "target": "meta-ads-client",
          "title": "Meta Business Login app",
          "label": "Save app configuration",
          "category": "Advertising",
          "intro": "Set client ID, client secret and the Business Login user-token config ID. This saves app setup only; restart sign-in after token expiry.",
          "usedFor": [
            "Configure the server-owned Meta Business Login flow"
          ],
          "helpUrl": "https://developers.facebook.com/docs/facebook-login/facebook-login-for-business/",
          "helpLabel": "Authentication and setup",
          "baseUrl": "https://graph.facebook.com",
          "saveKind": "oauth-client",
          "saveTarget": "meta-ads",
          "icon": "io.github.ainsep.openmarketing/assets/icon.svg",
          "fields": [
            {
              "name": "clientId",
              "label": "App ID",
              "required": true
            },
            {
              "name": "configId",
              "label": "Business Login config ID",
              "required": true,
              "hint": "User-token configuration with all required permissions; digits only."
            }
          ],
          "secretFields": [
            {
              "name": "clientSecret",
              "label": "App secret",
              "required": true
            }
          ]
        }
      ],
