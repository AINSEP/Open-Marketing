{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "x-ads",
  "version": "0.1.0",
  "description": "X Ads v12 reads, paused traffic deployment/readback and server-only conversions; disabled until server admission.",
